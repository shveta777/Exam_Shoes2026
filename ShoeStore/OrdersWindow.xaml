<Window x:Class="ShoeStore.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Заказы — ООО «Обувь»" Width="1130" Height="760"
        MinWidth="950" MinHeight="575" WindowStartupLocation="CenterScreen">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource HeaderBrush}" Padding="20,12">
            <DockPanel LastChildFill="True">
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/ShoeStore;component/Resources/Icon.png" Width="55" Height="55"
                       Stretch="Uniform" Margin="0,0,14,0"/>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="ProfileName" HorizontalAlignment="Right" FontWeight="Bold"/>
                    <TextBlock x:Name="ProfileRole" HorizontalAlignment="Right" Foreground="#234529"/>
                </StackPanel>
                <TextBlock Text="Заказы" VerticalAlignment="Center"
                           FontSize="30" FontWeight="Bold"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,14,20,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="0.6*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="OrderList" RowHeaderWidth="0" SelectionChanged="OrderList_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding OrderId}" Width="52"/>
                    <DataGridTextColumn Header="Покупатель" Binding="{Binding User.FullName}" Width="1.22*"/>
                    <DataGridTextColumn Header="Заказ" Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy}" Width="88"/>
                    <DataGridTextColumn Header="Доставка" Binding="{Binding DeliveryDate, StringFormat=dd.MM.yyyy}" Width="88"/>
                    <DataGridTextColumn Header="Пункт выдачи" Binding="{Binding PickupPoint.FullAddress}" Width="1.55*"/>
                    <DataGridTextColumn Header="Код" Binding="{Binding PickupCode}" Width="62"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding OrderStatus.StatusName}" Width="105"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="OrderLinesTitle" Grid.Row="1" Text="Состав заказа" Margin="0,14,0,7" FontWeight="Bold"/>
            <DataGrid x:Name="OrderLines" Grid.Row="2" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул | товар" Binding="{Binding ProductTitle}" Width="*"/>
                    <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
            <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Назад" Click="Back_Click" IsCancel="True"/>
                <StackPanel x:Name="OrderManagement" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Удалить" Click="DeleteOrder_Click" Margin="0,0,8,0"/>
                    <Button Content="Редактировать" Click="EditOrder_Click" Margin="0,0,8,0"/>
                    <Button Content="Добавить заказ" Click="AddOrder_Click" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
