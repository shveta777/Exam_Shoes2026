<Window x:Class="ShoeStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Вход в магазин «Обувь»" Width="1130" Height="760"
        MinWidth="950" MinHeight="575" WindowStartupLocation="CenterScreen">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource HeaderBrush}" Padding="20,12">
            <DockPanel LastChildFill="True">
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/ShoeStore;component/Resources/Icon.png" Width="55" Height="55"
                       Stretch="Uniform" Margin="0,0,14,0"/>
                <TextBlock Text="Магазин «Обувь»" VerticalAlignment="Center"
                           FontSize="30" FontWeight="Bold"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="26" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Вход" FontSize="27" FontWeight="Bold" Margin="0,0,0,18"/>
                <Label Content="Логин" Target="{Binding ElementName=LoginInput}" Padding="0,0,0,4"/>
                <TextBox x:Name="LoginInput" MaxLength="120" Margin="0,0,0,12"/>
                <Label Content="Пароль" Target="{Binding ElementName=PasswordInput}" Padding="0,0,0,4"/>
                <PasswordBox x:Name="PasswordInput" MaxLength="120" Margin="0,0,0,12"/>
                <TextBlock x:Name="LoginError" Foreground="#A00016" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                <UniformGrid Columns="2">
                    <Button Content="Войти" Click="SignIn_Click" Style="{StaticResource PrimaryButton}"
                            IsDefault="True" Margin="0,0,5,0"/>
                    <Button Content="Войти как гость" Click="Guest_Click" Margin="5,0,0,0"/>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
