<Window x:Class="ShoeStore.ShoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ShoeStore.Helpers"
        Style="{StaticResource {x:Type Window}}"
        Title="Каталог товаров — ООО «Обувь»" Width="1130" Height="760"
        MinWidth="950" MinHeight="575" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <helpers:PhotoConverter x:Key="PhotoConverter"/>
        <DataTemplate x:Key="ProductCard">
            <Border x:Name="Card" BorderBrush="#819083" BorderThickness="1"
                    Background="White" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="148"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="118"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="#819083" BorderThickness="1" Background="White" Padding="7">
                        <Image Source="{Binding ImageFile, Converter={StaticResource PhotoConverter}}"
                               Height="112" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="19" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"><Run Text="Описание: "/><Run Text="{Binding Description, Mode=OneWay}"/></TextBlock>
                        <TextBlock><Run Text="Производитель: "/><Run Text="{Binding Manufacturer.ManufacturerName, Mode=OneWay}"/></TextBlock>
                        <TextBlock><Run Text="Поставщик: "/><Run Text="{Binding Supplier.SupplierName, Mode=OneWay}"/></TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Цена: "/>
                            <Border x:Name="OldPrice" Background="White" Padding="4,0" Margin="0,0,5,0" Visibility="Collapsed">
                                <TextBlock Text="{Binding PriceText}" Foreground="#A00016" TextDecorations="Strikethrough"/>
                            </Border>
                            <TextBlock Text="{Binding FinalPriceText}" Foreground="Black" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock><Run Text="Количество на складе: "/><Run Text="{Binding StockQuantity, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                    <Border Grid.Column="2" Padding="8" BorderThickness="1" BorderBrush="#576957">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Действующая скидка" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="{Binding DiscountText}" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasLargeDiscount}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="#2E8B57"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="#ADD8E6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                    <Setter TargetName="OldPrice" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource HeaderBrush}" Padding="20,12">
            <DockPanel LastChildFill="True">
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/ShoeStore;component/Resources/Icon.png" Width="55" Height="55"
                       Stretch="Uniform" Margin="0,0,14,0"/>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="ProfileName" HorizontalAlignment="Right" FontWeight="Bold"/>
                    <TextBlock x:Name="ProfileRole" HorizontalAlignment="Right" Foreground="#234529"/>
                </StackPanel>
                <TextBlock Text="Каталог товаров" VerticalAlignment="Center"
                           FontSize="30" FontWeight="Bold"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,14,20,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid x:Name="CatalogTools" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="245"/>
                    <ColumnDefinition Width="245"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <Label Content="Поиск по товарам" Target="{Binding ElementName=SearchInput}" Padding="0,0,0,3"/>
                    <TextBox x:Name="SearchInput" TextChanged="SearchInput_TextChanged" MaxLength="200"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <Label Content="Поставщик" Target="{Binding ElementName=SupplierFilter}" Padding="0,0,0,3"/>
                    <ComboBox x:Name="SupplierFilter" DisplayMemberPath="SupplierName" SelectedValuePath="SupplierId"
                              SelectionChanged="CatalogChoice_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="Сортировка по остатку" Target="{Binding ElementName=StockSort}" Padding="0,0,0,3"/>
                    <ComboBox x:Name="StockSort" SelectionChanged="CatalogChoice_Changed">
                        <ComboBoxItem Content="Без сортировки"/>
                        <ComboBoxItem Content="По возрастанию"/>
                        <ComboBoxItem Content="По убыванию"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <ListBox x:Name="CatalogList" Grid.Row="1" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemTemplate="{StaticResource ProductCard}" KeyDown="CatalogList_KeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="CatalogItem_Click"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock Grid.Row="1" x:Name="CatalogEmpty" Visibility="Collapsed" Text="Товары не найдены"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22"/>
            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <Button DockPanel.Dock="Left" Content="Выйти" Click="Logout_Click"/>
                <Button x:Name="AddProductButton" DockPanel.Dock="Right" Content="Добавить товар"
                        Style="{StaticResource PrimaryButton}" Click="AddProduct_Click"/>
                <Button x:Name="OrdersButton" DockPanel.Dock="Right" Content="Заказы" Click="Orders_Click"
                        Margin="8,0"/>
                <TextBlock x:Name="CatalogCount" VerticalAlignment="Center" Margin="14,0,5,0"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
